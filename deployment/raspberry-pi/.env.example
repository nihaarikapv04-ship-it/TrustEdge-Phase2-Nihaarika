# Copy to /etc/trustedge.env on the Pi (mode 0600, root-owned). Never commit real secrets.
# Generate: python3 -c 'import secrets; print(secrets.token_hex(24))'

# --- required ---
TRUSTEDGE_API_TOKEN=replace_with_secrets_token_hex_24_chars_minimum
TRUSTEDGE_ADMIN_PASSWORD=replace_with_strong_admin_password
TRUSTEDGE_JWT_SECRET=replace_with_long_random_string

# --- optional RBAC (Phase 1 /p1 JWT login) ---
TRUSTEDGE_OPERATOR_PASSWORD=
TRUSTEDGE_VIEWER_PASSWORD=
# TRUSTEDGE_JWT_EXPIRY=3600

# --- physical interfaces (confirm with: ip -br link) ---
TRUSTEDGE_LAN_IF=eth1
TRUSTEDGE_WAN_IF=eth0
TRUSTEDGE_LAN_ADDR=192.168.50.1/24
TRUSTEDGE_LAN_SUBNET=192.168.50.0/24
TRUSTEDGE_DNS_UPSTREAM=

# --- API / storage (production binds loopback; SSH tunnel from MacBook) ---
TRUSTEDGE_BIND=127.0.0.1
TRUSTEDGE_API_PORT=8080
TRUSTEDGE_DATABASE=/var/lib/trustedge/gateway.sqlite

# --- paths used by scripts (override if non-standard install) ---
# TRUSTEDGE_ROOT=/opt/trustedge
# TRUSTEDGE_ENV=/etc/trustedge.env
# TRUSTEDGE_CONFIG=/etc/trustedge/gateway.json

# --- lab-only (never set on production Pi eth gateway) ---
# TRUSTEDGE_LAB_BIND=1
# TRUSTEDGE_WINDOW_SECONDS=5
